function [path, gScore_goal, turn_count, expanded_nodes, path_length, gScore_matrix, turnPenalty] = astar_planner_turn3(map, start, goal, payload_weight, cost_map, agv_type)
%{
% 功能：带转向惩罚的A*路径规划器（三维状态空间）
% 输入：
%   map          - 二值栅格地图，0=自由，1=障碍
%   start        - 起点坐标 [row, col]
%   goal         - 终点坐标 [row, col]
%   payload_weight - 载荷重量 (kg)
%   cost_map     - (可选) 地形代价地图，默认为1.0均匀代价
%   agv_type     - (可选) AGV类型：1=托举式(默认)，2=叉车式
% 输出：
%   path         - 规划出的路径点列表 (Nx2)
%   gScore_goal  - 到达目标的最小实际代价
%   turn_count   - 路径中的转向次数
%   expanded_nodes - 搜索过程中扩展的节点数量
%   path_length  - 路径包含的栅格点数
%   gScore_matrix - 到达各栅格的最小代价矩阵（二维）
%   turnPenalty  - 实际使用的转向惩罚值
%}

%% ==================== 第一部分：参数初始化与转向惩罚计算 ====================
    % 处理可选输入参数
    if nargin < 5
        cost_map = [];           % 未提供则默认空，后面统一用1.0
    end
    if nargin < 6 || isempty(agv_type)
        agv_type = 1;            % 默认为托举式AGV
    end

    % 根据AGV类型和载荷重量计算转向惩罚（二次模型）
    if agv_type == 2
        base_penalty = 1.35;      % 叉车式AGV空载转向代价更高（机动性差）
    else
        base_penalty = 0.90;      % 托举式AGV空载转向代价较低（机动性好）
    end
    linear_factor = 0.00001;      % 线性载荷系数（重量对转向的影响）
    inertia_factor = 3/640000;    % 二阶惯性系数（转动惯量）
    turnPenalty = base_penalty + linear_factor * payload_weight + inertia_factor * (payload_weight^2);
    % 转向惩罚 = 基础值 + 线性项 + 二次项，模拟不同重量下的转向难度

    [rows, cols] = size(map);    % 地图尺寸

%% ==================== 第二部分：起点终点合法性检查与全局参数 ====================
    % 如果起点或终点位于障碍物上，直接返回空路径
    if map(start(1), start(2)) == 1 || map(goal(1), goal(2)) == 1
        path = []; 
        gScore_goal = inf; 
        turn_count = 0; 
        expanded_nodes = 0; 
        path_length = 0; 
        gScore_matrix = []; 
        return;
    end

    % 计算起点到终点的欧氏距离，用于后续启发式的自适应调整
    dist_start_to_goal = sqrt((start(1) - goal(1))^2 + (start(2) - goal(2))^2);
    if dist_start_to_goal == 0
        dist_start_to_goal = 1e-6;  % 避免除零（起点=终点时设为极小值）
    end

%% ==================== 第三部分：3D状态空间与数据结构初始化 ====================
    % 三维状态：(行, 列, 进入方向)
    % 方向编码：1=北(上), 2=南(下), 3=西(左), 4=东(右)
    % 对应的行、列增量向量
    dirVecs = [-1, 0;   % 北
                1, 0;   % 南
                0, -1;  % 西
                0, 1];  % 东

    % 状态总数 = 行数 × 列数 × 4个方向
    numNodes3D = rows * cols * 4;

    % gScore(r,c,d): 从起点到达状态(r,c,d)的实际最小代价
    gScore = inf(rows, cols, 4);
    % fScore(r,c,d): 估计总代价 = g + h （用于A*排序）
    fScore = inf(rows, cols, 4);
    % parent_idx(r,c,d): 记录该状态的前驱节点的三维线性索引（用于路径回溯）
    parent_idx = zeros(rows, cols, 4);

    % 开放列表（存储待扩展节点的三维线性索引）和对应的布尔掩码
    openList = [];
    openMask = false(numNodes3D, 1);

    % 初始化起点：由于起点没有进入方向，将4个方向都视为0代价的起点状态
    for d = 1:4
        gScore(start(1), start(2), d) = 0;
        % 启发式采用曼哈顿距离（保证可纳性且计算快）
        fScore(start(1), start(2), d) = abs(start(1)-goal(1)) + abs(start(2)-goal(2));
        % 计算三维线性索引（列优先）: idx = r + (c-1)*rows + (d-1)*rows*cols
        idx3D = start(1) + (start(2)-1)*rows + (d-1)*(rows*cols);
        openList(end+1) = idx3D;
        openMask(idx3D) = true;
    end

    % 搜索状态标志
    pathFound = false;
    expanded_nodes = 0;     % 扩展节点计数器
    bestGoalIdx3D = -1;     % 到达目标时保存的最优状态索引

%% ==================== 第四部分：A*主循环 ====================
    while ~isempty(openList)
        % 从开放列表中选取fScore最小的节点（即最具潜力的节点）
        [~, minPos] = min(fScore(openList));
        curr3D = openList(minPos);
        expanded_nodes = expanded_nodes + 1;   % 每次弹出都计为一次扩展
        
        % 将该节点从开放列表中移除
        openList(minPos) = [];
        openMask(curr3D) = false;

        % 将三维线性索引转换为 (r,c,d) ，便于后续计算
        rem_idx = curr3D - 1;                     % 转换为0基索引
        currD = floor(rem_idx / (rows * cols)) + 1; % 方向（1~4）
        rem_idx = mod(rem_idx, rows * cols);
        currC = floor(rem_idx / rows) + 1;         % 列
        currR = mod(rem_idx, rows) + 1;            % 行

        % 目标测试：如果当前格就是目标格，则找到路径
        if currR == goal(1) && currC == goal(2)
            pathFound = true;
            bestGoalIdx3D = curr3D;
            break;
        end

        % 遍历四个邻居方向（可能的移动方向）
        for nD = 1:4
            nR = currR + dirVecs(nD, 1);
            nC = currC + dirVecs(nD, 2);

            % 越界或障碍物检查
            if nR < 1 || nR > rows || nC < 1 || nC > cols || map(nR, nC) == 1
                continue;
            end

            % 地形代价：若提供了cost_map，则读取对应栅格的代价，否则为1.0
            terrain_cost = 1.0;
            if nargin >= 5 && ~isempty(cost_map)
                if nR <= size(cost_map, 1) && nC <= size(cost_map, 2)
                    terrain_cost = cost_map(nR, nC);
                end
            end

            % 计算从当前状态移动到邻居的基本代价（移动代价 × 地形代价）
            move_cost = 1.0 * terrain_cost;
            tentative_gScore = gScore(currR, currC, currD) + move_cost;

            % 转向惩罚：非起点且移动方向与进入方向不同时，加上转向惩罚
            isStartNode = (currR == start(1) && currC == start(2));
            if ~isStartNode && nD ~= currD
                tentative_gScore = tentative_gScore + turnPenalty;
            end

            % 如果新代价比已记录的更优，则更新该邻居状态
            if tentative_gScore < gScore(nR, nC, nD)
                gScore(nR, nC, nD) = tentative_gScore;
                parent_idx(nR, nC, nD) = curr3D;   % 记录前驱节点索引

                % 计算启发式h：曼哈顿距离
                h_base = abs(nR - goal(1)) + abs(nC - goal(2));

                % 自适应启发式权重：根据当前点到目标的距离动态调整
                % 距离目标越远，略微增大启发式权重，使搜索更有方向性
                dist_current_to_goal = sqrt((nR - goal(1))^2 + (nC - goal(2))^2);
                a_raw = exp(dist_current_to_goal / dist_start_to_goal) - 1.0;  % 原始指数因子
                a_compressed = a_raw * 0.4;  % 压缩到合理范围，避免过度膨胀
                % 最终f = g + h * (1 + a_compressed)
                fScore(nR, nC, nD) = tentative_gScore + h_base * (1.0 + a_compressed);

                % 计算邻居状态的三维线性索引
                neighbor3D = nR + (nC-1)*rows + (nD-1)*(rows*cols);

                % 如果邻居还不在开放列表中，则加入
                if ~openMask(neighbor3D)
                    openList(end+1) = neighbor3D;
                    openMask(neighbor3D) = true;
                end
            end
        end
    end

%% ==================== 第五部分：路径回溯与结果统计 ====================
    if pathFound
        % 从目标状态开始，沿着parent_idx回溯至起点
        curr = bestGoalIdx3D;
        path_list = [];   % 用于存储路径点（从终点向起点回溯，最后翻转）

        while curr ~= 0
            % 提取当前索引对应的栅格坐标
            rem_idx = curr - 1;
            rem_idx = mod(rem_idx, rows * cols);
            c = floor(rem_idx / rows) + 1;
            r = mod(rem_idx, rows) + 1;
            
            % 将点插入到列表开头（保证最终顺序是从起点到终点）
            path_list = [[r, c]; path_list];

            % 如果回溯到起点，终止
            if r == start(1) && c == start(2)
                break;
            end

            % 获取当前状态的方向，并跳转到前驱状态
            currD = floor((curr - 1) / (rows * cols)) + 1;
            curr = parent_idx(r, c, currD);
        end

        path = path_list;   % 最终路径

        % 到达目标的最小代价（取终点所有方向中最小的gScore）
        gScore_goal = min(gScore(goal(1), goal(2), :));

        % 路径长度（经过的栅格点数）
        path_length = size(path, 1);

        % 统计转向次数：通过比较相邻两步的位移向量是否变化来判断
        turn_count = 0;
        if size(path, 1) > 2
            diffs = diff(path);   % 相邻点位移向量 (N-1)x2
            for i = 2:size(diffs, 1)
                if ~isequal(diffs(i,:), diffs(i-1,:))
                    turn_count = turn_count + 1;   % 位移向量变化即表示转向
                end
            end
        end
    else
        % 未找到路径，返回空结果
        path = []; 
        gScore_goal = inf; 
        turn_count = 0; 
        path_length = 0; 
    end

    % 生成二维代价矩阵（每个栅格取四个方向的最小gScore），用于可视化或分析
    gScore_matrix = min(gScore, [], 3);

    % 实际扩展的二维栅格数量：gScore有限值的栅格即为被探索过的栅格
    explored_2d_mask = (gScore_matrix ~= inf);
    expanded_nodes = sum(explored_2d_mask, 'all');

end