%% 项目布局地图建模
% 区域编码（0-9）：
% 0: 自由通道（可通行）
% 1: 托架（共300个）
% 2: 托架式AGV充电桩
% 3: 叉车式AGV充电桩
% 4: 托架式AGV车库
% 5: 叉车式AGV车库
% 6: 相关配件仓库储存区域
% 7: 所需相关配件工位
% 8: 维修线
% 9: 障碍物（墙壁等）

clear; clc; close all;

%% 1. 地图尺寸设定（可根据实际布局调整）
% 假设托架占15行×20列，周边留有通道和其他区域
rows = 51;   % 总行数
cols = 51;   % 总列数
map = zeros(rows, cols); % 初始化为自由通道

%% 2. 布置托架区域（编号1）
% 托架按行优先排列：托架1在(1,1)，托架2在(1,2)，…，托架20在(1,20)，
% 托架21在(2,1)，依此类推。共15行，每行20个。
tray_rows = 15;
tray_cols = 20;
for r = 1:tray_rows
    for c = 1:tray_cols
        map(r, c) = 1;   % 托架
    end
end

%% 3. 其他设施位置（示例位置，请根据实际图纸修改）
% 托架式AGV充电桩（2）——例如放在托架区域右侧
map(2, 2) = 2;
map(6, 25) = 2;

% 叉车式AGV充电桩（3）
map(10, 25) = 3;
map(11, 25) = 3;

% 托架式AGV车库（4）——假设占据连续区域
map(15, 25:28) = 4;

% 叉车式AGV车库（5）
map(20, 25:28) = 5;

% 相关配件仓库储存区域（6）——矩形区域
map(25:30, 30:35) = 6;

% 所需相关配件工位（7）
map(35:38, 30:35) = 7;

% 维修线（8）
map(40:45, 30:35) = 8;

% 障碍物（9）：边界和内部障碍
map(1, :) = 9;          % 上边界
map(end, :) = 9;        % 下边界
map(:, 1) = 9;          % 左边界
map(:, end) = 9;        % 右边界
% 添加一些内部障碍（示例，可根据图纸调整）
map(20:22, 10:12) = 9;

%% 4. 可视化地图
figure('Name', '项目布局地图', 'NumberTitle', 'off', 'Position', [100 100 800 600]);
imagesc(map);
% 自定义颜色（与图例对应）
color_map = [1 1 1;      % 0 自由通道 - 白色
             0.5 0.5 0.5; % 1 托架 - 灰色
             1 0 0;       % 2 托架充电桩 - 红色
             0 1 0;       % 3 叉车充电桩 - 绿色
             0 0 1;       % 4 托架车库 - 蓝色
             1 1 0;       % 5 叉车库 - 黄色
             1 0 1;       % 6 仓库 - 品红
             0 1 1;       % 7 工位 - 青色
             0.5 0 0.5;   % 8 维修线 - 紫色
             0 0 0];      % 9 障碍物 - 黑色
colormap(gca, color_map);
colorbar('Ticks', 0:9, 'TickLabels', {'自由通道', '托架', '托架充电桩', '叉车充电桩', ...
                                      '托架车库', '叉车库', '仓库', '工位', '维修线', '障碍'});
axis equal tight;
title('项目布局栅格地图（请根据实际图纸调整坐标）');

% 添加栅格线以便观察
ax = gca;
ax.XTick = 0.5:1:cols+0.5;
ax.YTick = 0.5:1:rows+0.5;
ax.XTickLabel = [];
ax.YTickLabel = [];
grid on;
ax.GridColor = [0.5 0.5 0.5];
ax.GridAlpha = 0.3;

%% 5. 导出地图矩阵（可选）
% save('project_map.mat', 'map');
disp('地图建模完成！请根据实际图纸调整各设施的坐标。');